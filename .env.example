# Copy to .env for local overrides. Never commit .env.

# Database (docker compose builds DATABASE_URL for the api service from these)
POSTGRES_USER=irerero
POSTGRES_PASSWORD=irerero
POSTGRES_DB=irerero
DATABASE_URL=postgresql+psycopg://irerero:irerero@localhost:5432/irerero  # pragma: allowlist secret

# API
CORS_ORIGINS=["http://localhost:3000"]

# Web: where the Next.js server reaches the API
API_INTERNAL_URL=http://localhost:8000
