# Copy to .env for local overrides. Never commit .env.

# Database. Leave unset to use the local SQLite file data/irerero.sqlite.
# Set to a Postgres URL (Supabase or Neon) when deployed, so plans, check-ins, course progress
# and the audit log survive app restarts. On Streamlit Community Cloud, put it in the app's
# Secrets as DATABASE_URL instead.
# DATABASE_URL=postgresql://user:password@host:5432/irerero  # pragma: allowlist secret

# Demo mode shows the role selector with fictional demo users. Turn off for real users.
DEMO_MODE=true

# IrereroAI assistant (optional). Without a key the question box says it is not set up.
# On Streamlit Community Cloud, put these in the app's Secrets instead.
# ANTHROPIC_API_KEY=
# IRERERO_ASSISTANT_MODEL=claude-opus-5-5
# IRERERO_ASSISTANT_EFFORT=medium
# IRERERO_ASSISTANT_FALLBACKS=on

# Private data bundle for a deployment (docs/deploy_private_data.md). Leave empty for the demo.
# IRERERO_DATA_URL=https://api.github.com/repos/<owner>/irereroai-data/contents/irerero-data.zip
# IRERERO_DATA_TOKEN=
# IRERERO_DATA_SHA256=
# Provisional school list in the same private repository, fetched with the same token.
# IRERERO_SCHOOLS_PATH=schools/Rwandapreprimarydata_locatios.GeoJSON
# IRERERO_SCHOOLS_SHA256=
# Or a full address instead of a path (https only):
# IRERERO_SCHOOLS_URL=https://api.github.com/repos/<owner>/<repo>/contents/<path>
