{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irereroai.rw/contract/admin_unit.schema.json",
  "title": "admin_unit",
  "description": "Administrative areas from country down to village, with geometry simplified per zoom.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "level",
    "geom",
    "geom_medium",
    "geom_coarse",
    "centroid",
    "area_km2",
    "source",
    "reference_year",
    "origin"
  ],
  "properties": {
    "code": {
      "type": "string",
      "maxLength": 64,
      "description": "Stable IrereroAI code, e.g. D-GICUMBI or S-GICUMBI-BYUMBA. All tables join on it"
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "description": "Official name as published"
    },
    "level": {
      "type": "string",
      "enum": [
        "country",
        "province",
        "district",
        "sector",
        "cell",
        "village"
      ],
      "description": "country | province | district | sector | cell | village"
    },
    "parent_code": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ],
      "description": "Code of the enclosing unit"
    },
    "nisr_code": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 16
        },
        {
          "type": "null"
        }
      ],
      "description": "Official NISR administrative code. Filled by the Phase 2 boundaries adapter"
    },
    "source_ref": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ],
      "description": "Identifier in the boundary source, e.g. the geoBoundaries shapeID"
    },
    "geom": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 28.8,
                    "maximum": 31.0
                  },
                  {
                    "type": "number",
                    "minimum": -2.9,
                    "maximum": -1.0
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      },
      "description": "Boundary, EPSG:4326, full detail"
    },
    "geom_medium": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 28.8,
                    "maximum": 31.0
                  },
                  {
                    "type": "number",
                    "minimum": -2.9,
                    "maximum": -1.0
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      },
      "description": "Boundary simplified for district zoom (about 50 m tolerance)"
    },
    "geom_coarse": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 28.8,
                    "maximum": 31.0
                  },
                  {
                    "type": "number",
                    "minimum": -2.9,
                    "maximum": -1.0
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      },
      "description": "Boundary simplified for national zoom (about 500 m tolerance)"
    },
    "centroid": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 28.8,
              "maximum": 31.0
            },
            {
              "type": "number",
              "minimum": -2.9,
              "maximum": -1.0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "description": "Point on surface, EPSG:4326"
    },
    "area_km2": {
      "type": "number",
      "minimum": 0,
      "description": "Area computed in EPSG:32735 (UTM 35S)"
    },
    "source": {
      "type": "string",
      "maxLength": 160,
      "description": "Named source, for example \"NISR Census 2022\" or \"IrereroAI demo generator\""
    },
    "reference_year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100,
      "description": "Year the values describe, not the year they were loaded"
    },
    "origin": {
      "type": "string",
      "enum": [
        "official",
        "public",
        "partner",
        "simulated"
      ],
      "description": "official | public | partner | simulated. Drives UI badges"
    },
    "pipeline_run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Pipeline run that loaded the row. Null for records entered through the app"
    }
  }
}
