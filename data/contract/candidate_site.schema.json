{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irereroai.rw/contract/candidate_site.schema.json",
  "title": "candidate_site",
  "description": "A place where an action could happen: a village or school to build at, or a centre.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "sector_code",
    "location",
    "unit_cost_band",
    "source",
    "reference_year",
    "origin"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 32,
      "description": "Site code"
    },
    "kind": {
      "type": "string",
      "enum": [
        "village",
        "school",
        "centre_upgrade",
        "centre_support"
      ],
      "description": "village | school | centre_upgrade | centre_support"
    },
    "name": {
      "type": "string",
      "maxLength": 160,
      "description": "Village, school or centre name"
    },
    "sector_code": {
      "type": "string",
      "maxLength": 64,
      "description": "Sector of the site"
    },
    "centre_code": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ],
      "description": "Existing centre for upgrade and support sites"
    },
    "location": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 28.8,
              "maximum": 31.0
            },
            {
              "type": "number",
              "minimum": -2.9,
              "maximum": -1.0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "description": "Site location, EPSG:4326"
    },
    "unit_cost_band": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Cost band looked up in unit_cost"
    },
    "source": {
      "type": "string",
      "maxLength": 160,
      "description": "Named source, for example \"NISR Census 2022\" or \"IrereroAI demo generator\""
    },
    "reference_year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100,
      "description": "Year the values describe, not the year they were loaded"
    },
    "origin": {
      "type": "string",
      "enum": [
        "official",
        "public",
        "partner",
        "simulated"
      ],
      "description": "official | public | partner | simulated. Drives UI badges"
    },
    "pipeline_run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Pipeline run that loaded the row. Null for records entered through the app"
    }
  }
}
