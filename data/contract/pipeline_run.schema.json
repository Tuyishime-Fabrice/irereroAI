{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irereroai.rw/contract/pipeline_run.schema.json",
  "title": "pipeline_run",
  "description": "One execution of an adapter or the demo generator, with its checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline",
    "origin",
    "status",
    "started_at",
    "code_version",
    "inputs",
    "row_counts",
    "checks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Run id"
    },
    "pipeline": {
      "type": "string",
      "maxLength": 48,
      "description": "Adapter or generator name, e.g. demo_generator"
    },
    "origin": {
      "type": "string",
      "enum": [
        "official",
        "public",
        "partner",
        "simulated"
      ],
      "description": "Origin of the rows loaded"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "succeeded",
        "failed"
      ],
      "description": "running | succeeded | failed"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Start time"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "End time"
    },
    "code_version": {
      "type": "string",
      "maxLength": 64,
      "description": "Git commit or package version"
    },
    "inputs": {
      "description": "Input files with sha256 and size: [{path, sha256, bytes}]"
    },
    "row_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Rows written per table"
    },
    "checks": {
      "description": "Checks run: [{name, passed, detail}]"
    }
  }
}
