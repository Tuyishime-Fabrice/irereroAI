{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irereroai.rw/contract/weekly_report.schema.json",
  "title": "weekly_report",
  "description": "The weekly centre report: about ten counts, no child-level data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "centre_code",
    "week_start",
    "enrolled_0_2_female",
    "enrolled_0_2_male",
    "enrolled_3_6_female",
    "enrolled_3_6_male",
    "avg_daily_attendance",
    "waiting_list",
    "caregivers_present",
    "days_open",
    "days_meal_served",
    "wash_available",
    "referrals_growth_monitoring",
    "children_with_disability",
    "main_problem",
    "channel",
    "source",
    "reference_year",
    "origin"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Report id"
    },
    "centre_code": {
      "type": "string",
      "maxLength": 32,
      "description": "Reporting centre"
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Monday of the reported week"
    },
    "enrolled_0_2_female": {
      "type": "integer",
      "minimum": 0,
      "description": "Girls aged 0 to 2 enrolled"
    },
    "enrolled_0_2_male": {
      "type": "integer",
      "minimum": 0,
      "description": "Boys aged 0 to 2 enrolled"
    },
    "enrolled_3_6_female": {
      "type": "integer",
      "minimum": 0,
      "description": "Girls aged 3 to 6 enrolled"
    },
    "enrolled_3_6_male": {
      "type": "integer",
      "minimum": 0,
      "description": "Boys aged 3 to 6 enrolled"
    },
    "avg_daily_attendance": {
      "type": "integer",
      "minimum": 0,
      "description": "Average number of children present per open day"
    },
    "waiting_list": {
      "type": "integer",
      "minimum": 0,
      "description": "Children waiting for a place"
    },
    "caregivers_present": {
      "type": "integer",
      "minimum": 0,
      "description": "Caregivers present on a typical day"
    },
    "days_open": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "Days the centre opened this week, 0 to 6"
    },
    "days_meal_served": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "Days a meal was served, 0 to 6"
    },
    "wash_available": {
      "type": "boolean",
      "description": "Water and handwashing were available all week"
    },
    "referrals_growth_monitoring": {
      "type": "integer",
      "minimum": 0,
      "description": "Children referred to growth monitoring this week"
    },
    "children_with_disability": {
      "type": "integer",
      "minimum": 0,
      "description": "Enrolled children with a known disability"
    },
    "main_problem": {
      "type": "string",
      "enum": [
        "none",
        "no_food",
        "no_water",
        "caregiver_absent",
        "building_damage",
        "weather",
        "other"
      ],
      "description": "none | no_food | no_water | caregiver_absent | building_damage | weather | other"
    },
    "channel": {
      "type": "string",
      "enum": [
        "web",
        "offline",
        "sms",
        "assisted"
      ],
      "description": "web | offline | sms | assisted"
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "out_of_range_confirmed",
          "enrolment_jump",
          "attendance_jump",
          "late_submission"
        ]
      },
      "description": "Validation flags. Flagged reports are kept and shown, never silently accepted"
    },
    "submitted_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Account that submitted or entered the report"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the server received it"
    },
    "source": {
      "type": "string",
      "maxLength": 160,
      "description": "Named source, for example \"NISR Census 2022\" or \"IrereroAI demo generator\""
    },
    "reference_year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100,
      "description": "Year the values describe, not the year they were loaded"
    },
    "origin": {
      "type": "string",
      "enum": [
        "official",
        "public",
        "partner",
        "simulated"
      ],
      "description": "official | public | partner | simulated. Drives UI badges"
    },
    "pipeline_run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Pipeline run that loaded the row. Null for records entered through the app"
    }
  }
}
